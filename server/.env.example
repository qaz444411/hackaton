PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=bapfriend

JWT_SECRET=change-me-please
JWT_EXPIRES=7d

# 카카오 지도 - REST API 키(서버 전용, 장소 검색 프록시에 사용)
KAKAO_REST_API_KEY=your_kakao_rest_key
# 제미나이 챗봇 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key
# 모델은 계정/시점에 따라 제공 여부가 달라진다. gemini-2.0-flash / 2.5-flash 는
# 신규 발급 키에서 404 가 난다. `npm run gemini:check` 로 실제 되는 모델을 확인할 것.
GEMINI_MODEL=gemini-3.6-flash

# --- AI 제공자 -----------------------------------------------
# gemini  : 제미나이 API 키로 호출 (기본값)
# bedrock : AWS Bedrock(Claude). EC2 인스턴스 프로파일로 인증하므로
#           Access Key 를 넣지 않는다. 리전은 docker-compose 의
#           AWS_DEFAULT_REGION 이 정한다 (코드에 하드코딩하지 않는다).
# 되돌릴 때는 이 값만 gemini 로 바꾸고 api 컨테이너를 재시작하면 된다.
AI_PROVIDER=gemini
# 반드시 global. 접두사가 붙은 추론 프로파일이어야 한다.
# raw ID 는 on-demand throughput 미지원 오류로 거부된다.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_DEFAULT_REGION=us-west-2
