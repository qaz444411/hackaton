# ---------------------------------------------------------------
# 배포용 환경변수 템플릿
#
#   이 파일을 .env.production 으로 복사해서 실제 값을 채운다.
#   .env.production 은 .gitignore 에 걸려 있어 커밋되지 않는다.
#
#   docker compose --env-file .env.production up -d --build
#
#   ※ server/.env (로컬 개발용) 와는 별개 파일이다. 섞지 말 것.
# ---------------------------------------------------------------

PORT=4000

# 허용할 프론트 오리진. 쉼표로 여러 개를 넣을 수 있고, 뒤에 슬래시는 붙이지 않는다.
# app.js 의 cors 와 chatSocket.js 의 Socket.IO 가 브라우저의 Origin 헤더와
# 문자열을 정확히 비교하기 때문이다.
# https 전환 중에는 http(IP) 도 함께 열어둬서 롤백 여지를 남긴다.
CLIENT_ORIGIN=https://35.86.162.39.nip.io,http://35.86.162.39

# --- HTTPS ----------------------------------------------------
# 인증서를 발급받을 도메인. IP 로는 인증서를 못 받아 nip.io 와일드카드 DNS 를 쓴다.
# (35.86.162.39.nip.io -> 35.86.162.39 로 해석된다)
# 이 도메인으로 인증서가 존재할 때만 nginx 443 블록이 켜진다. 비우면 80 만 뜬다.
DOMAIN=35.86.162.39.nip.io
# HTTPS 가 실제로 되는 걸 확인한 뒤 1 로 바꾼다. 0 이면 80 도 앱을 그대로 서빙한다.
REDIRECT_HTTP_TO_HTTPS=0
# 인증서 만료 알림을 받을 주소
CERTBOT_EMAIL=

# --- DB -------------------------------------------------------
# DB_HOST / DB_PORT 는 compose 가 db:3306 으로 덮어쓰므로 여기 값은 무시된다.
DB_USER=root
# MySQL 컨테이너의 root 비밀번호로도 함께 쓰인다.
# 로컬 개발용 1234 를 그대로 올리지 말 것.
DB_PASSWORD=여기에_새_비밀번호
DB_NAME=bapfriend

# --- 인증 -----------------------------------------------------
# 로컬 개발용 dev-local-only-... 를 재사용하지 말 것.
# 공인 IP 로 열려 있는 서버다.
JWT_SECRET=여기에_새_시크릿
JWT_EXPIRES=7d

# --- 외부 API -------------------------------------------------
# 서버 전용 REST 키 (장소 검색 프록시)
KAKAO_REST_API_KEY=

# 제미나이 챗봇
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- 프론트 빌드 인자 -----------------------------------------
# 카카오 지도 JavaScript 키. 빌드 시점에 번들에 박힌다.
# ★ 카카오 콘솔 > 플랫폼 > Web 에 아래를 모두 등록해야 지도가 뜬다:
#     https://35.86.162.39.nip.io
#     http://35.86.162.39
VITE_KAKAO_JS_KEY=

# --- AI 제공자 -----------------------------------------------
# gemini  : 제미나이 API 키로 호출 (기본값)
# bedrock : AWS Bedrock(Claude). EC2 인스턴스 프로파일로 인증하므로
#           Access Key 를 넣지 않는다. 리전은 docker-compose 의
#           AWS_DEFAULT_REGION 이 정한다 (코드에 하드코딩하지 않는다).
# 되돌릴 때는 이 값만 gemini 로 바꾸고 api 컨테이너를 재시작하면 된다.
AI_PROVIDER=gemini
# 반드시 global. 접두사가 붙은 추론 프로파일이어야 한다.
# raw ID 는 on-demand throughput 미지원 오류로 거부된다.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_DEFAULT_REGION=us-west-2
