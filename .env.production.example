# ---------------------------------------------------------------
# 배포용 환경변수 템플릿
#
#   이 파일을 .env.production 으로 복사해서 실제 값을 채운다.
#   .env.production 은 .gitignore 에 걸려 있어 커밋되지 않는다.
#
#   docker compose --env-file .env.production up -d --build
#
#   ※ server/.env (로컬 개발용) 와는 별개 파일이다. 섞지 말 것.
# ---------------------------------------------------------------

PORT=4000

# 배포 주소. 뒤에 슬래시를 붙이지 않는다.
# app.js 의 cors({ origin }) 과 chatSocket.js 의 Socket.IO cors 가
# 브라우저의 Origin 헤더와 문자열을 정확히 비교한다.
CLIENT_ORIGIN=http://35.86.162.39

# --- DB -------------------------------------------------------
# DB_HOST / DB_PORT 는 compose 가 db:3306 으로 덮어쓰므로 여기 값은 무시된다.
DB_USER=root
# MySQL 컨테이너의 root 비밀번호로도 함께 쓰인다.
# 로컬 개발용 1234 를 그대로 올리지 말 것.
DB_PASSWORD=여기에_새_비밀번호
DB_NAME=bapfriend

# --- 인증 -----------------------------------------------------
# 로컬 개발용 dev-local-only-... 를 재사용하지 말 것.
# 공인 IP 로 열려 있는 서버다.
JWT_SECRET=여기에_새_시크릿
JWT_EXPIRES=7d

# --- 외부 API -------------------------------------------------
# 서버 전용 REST 키 (장소 검색 프록시)
KAKAO_REST_API_KEY=

# 제미나이 챗봇
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- 프론트 빌드 인자 -----------------------------------------
# 카카오 지도 JavaScript 키. 빌드 시점에 번들에 박힌다.
# ★ 카카오 콘솔 > 플랫폼 > Web 에 http://35.86.162.39 를 등록해야 지도가 뜬다.
VITE_KAKAO_JS_KEY=
